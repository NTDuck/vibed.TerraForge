  "devDependencies": {
    "@types/bun": "^1.4.2",
    "bun-types": "^1.4.2"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0"
  }
}
