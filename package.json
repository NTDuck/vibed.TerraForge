{
  "name": "senchain-mockup",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bunx tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/main.ts --outdir dist --minify && python3 tools/build_fonts.py",
    "serve": "bun serve.ts",
    "dev": "bun run build && bun run serve",
    "fonts": "python3 tools/build_fonts.py"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "bun-types": "^1.4.2"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.3.0"
  }
}
